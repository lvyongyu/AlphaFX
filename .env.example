# Copy to .env (gitignored) and fill in your key to enable LLM explanations locally.
# The app loads .env automatically; without it, it falls back to template text.
ANTHROPIC_API_KEY=sk-ant-...

# IG Demo execution layer (alphafx/execution/). Optional: the research platform
# runs fine without these — only the execution scripts need them.
# These are the Web API DEMO credentials from My IG -> Settings -> Web API, which
# are a SEPARATE username from your IG platform login. Using the platform
# username fails with error.security.invalid-details, which looks like a wrong
# password but is not.
IG_USERNAME=your-demo-api-username
IG_PASSWORD=your-demo-api-password
IG_API_KEY=your-demo-api-key
